# Скопируйте этот файл в .env и оставьте один блок — тот, которым будете пользоваться.

# --- Anthropic (платно, лучшее качество вызова инструментов) ---
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-5

# --- Ollama: модель крутится локально, бесплатно, интернет не нужен ---
# Установить с ollama.com, затем: ollama pull qwen3:8b
# AGENT_PROVIDER=ollama
# AGENT_MODEL=qwen3:8b

# --- Groq: бесплатный тариф, ключ на console.groq.com ---
# Список доступных моделей меняется — актуальный: https://api.groq.com/openai/v1/models
# AGENT_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# AGENT_MODEL=openai/gpt-oss-120b

# --- OpenRouter: есть бесплатные модели, ключ на openrouter.ai ---
# AGENT_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# AGENT_MODEL=qwen/qwen3-8b:free

# --- Любой другой сервер с /chat/completions ---
# AGENT_PROVIDER=lmstudio
# AGENT_BASE_URL=http://localhost:1234/v1
# AGENT_MODEL=...
# AGENT_API_KEY=...
